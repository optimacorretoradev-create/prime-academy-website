# Hygraph CMS Configuration
# Get your endpoint from Hygraph dashboard > Project Settings > API Access
NEXT_PUBLIC_HYGRAPH_ENDPOINT=https://api-eu-central-1.hygraph.com/v2/your-project-id/master

# Optional: For draft content access (get from API Access > Permanent Auth Tokens)
HYGRAPH_API_TOKEN=your-readonly-token

# Cache revalidation token (for webhook security)
REVALIDATION_SECRET_TOKEN=your-secure-random-token-here

# EmailJS Configuration (for contact & enrollment forms)
# Get your keys from https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key
# Specific templates (recommended)
NEXT_PUBLIC_EMAILJS_CONTACT_TEMPLATE_ID=your-contact-template-id
NEXT_PUBLIC_EMAILJS_ENROLL_TEMPLATE_ID=your-enroll-template-id
# Generic fallback (optional)
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-fallback-template-id
# Private Key (required for non-browser environments if enabled in Security settings)
EMAILJS_PRIVATE_KEY=your-private-key


# Alternative: Resend API (for server-side emails)
# Get your key from https://resend.com/
RESEND_API_KEY=your-resend-api-key

# Supabase (obrigatório para notificações admin e remover utilizadores)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Settings → API → service_role (NUNCA expor no cliente)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
