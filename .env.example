# Hygraph CMS Configuration
# Get your endpoint from Hygraph dashboard > Project Settings > API Access
NEXT_PUBLIC_HYGRAPH_ENDPOINT=https://api-eu-central-1.hygraph.com/v2/your-project-id/master

# Optional: For draft content access (get from API Access > Permanent Auth Tokens)
HYGRAPH_API_TOKEN=your-readonly-token

# EmailJS Configuration (for contact forms)
# Get your keys from https://www.emailjs.com/
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your-service-id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your-template-id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your-public-key

# Alternative: Resend API (for server-side emails)
# Get your key from https://resend.com/
RESEND_API_KEY=your-resend-api-key
